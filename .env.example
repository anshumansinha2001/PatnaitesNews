# ---- Environment variables required on Vercel ----
# Copy these into the Vercel project settings (Project → Settings → Environment
# Variables). Do NOT commit real secrets.

# MongoDB Atlas connection string.
# Vercel's DNS resolves SRV records fine, so the standard mongodb+srv:// URI
# works in production:
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=

# The public site origin (no trailing slash). Used for canonical URLs,
# Open Graph tags, sitemap and robots. e.g. https://patnaitesmedia.com
NEXT_PUBLIC_DOMAIN=

# Cloudinary (image hosting / uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# TinyMCE rich-text editor (admin)
NEXT_PUBLIC_TINYMCE_API_KEY=

# Admin login credentials
NEXT_PUBLIC_ADMIN_USERNAME=
NEXT_PUBLIC_ADMIN_PASSWORD=
